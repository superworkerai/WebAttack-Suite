# Simple .env configuration for WebAttack Suite
# Copy this to .env and fill in your values

# Your target URL
TARGET_URL=https://example.com

# Your session cookie (get from browser DevTools → Application → Cookies)
# Format: name1=value1,name2=value2
COOKIES=session=your_session_token_here

# How deep to crawl (1-5, default: 3)
CRAWL_DEPTH=3

# Maximum pages to test (default: 50)
MAX_PAGES=50

# AI-powered test suggestions (optional)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

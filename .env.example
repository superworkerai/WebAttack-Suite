# WebAttack Suite Configuration
# Copy this file to .env and fill in your values

# ============================================
# TARGET CONFIGURATION
# ============================================

# Target URL to scan (required if not passed via CLI)
TARGET_URL=https://example.com

# ============================================
# AUTHENTICATION
# ============================================

# Session cookies (comma-separated for multiple cookies)
# Format: name1=value1,name2=value2,name3=value3
# Example: session=abc123xyz,csrf_token=token789,user_id=12345
COOKIES=

# Cookie domain (optional, defaults to target domain)
COOKIE_DOMAIN=

# ============================================
# CRAWLING CONFIGURATION
# ============================================

# Crawl depth (0 = no crawling, default: 3)
# Depth 1: ~10-20 pages
# Depth 2: ~20-40 pages
# Depth 3: ~40-80 pages (recommended)
# Depth 4+: Use with MAX_PAGES limit
CRAWL_DEPTH=3

# Maximum pages to crawl (default: 50)
MAX_PAGES=50

# ============================================
# SCAN CONFIGURATION
# ============================================

# Request timeout in milliseconds (default: 30000)
TIMEOUT=30000

# Run in headless mode (true/false, default: true)
HEADLESS=true

# Output directory for reports (default: ./reports)
OUTPUT_DIR=./reports

# ============================================
# TEST SELECTION
# ============================================

# Include only specific tests (comma-separated)
# Leave empty to run all tests
# Example: XSS Vulnerability Tests,SQL Injection Tests
INCLUDE_TESTS=

# Exclude specific tests (comma-separated)
# Example: Business Logic Tests,SSL/TLS Security Tests
EXCLUDE_TESTS=

# ============================================
# REPORT OPTIONS
# ============================================

# Generate only JSON report (true/false)
JSON_ONLY=false

# Generate only HTML report (true/false)
HTML_ONLY=false

# ============================================
# ADVANCED OPTIONS
# ============================================

# Custom User-Agent string
USER_AGENT=

# Custom HTTP headers (JSON format)
# Example: {"Authorization": "Bearer token", "X-Custom": "value"}
CUSTOM_HEADERS=

# ============================================
# EXAMPLE CONFIGURATIONS
# ============================================

# Example 1: Basic authenticated scan
# TARGET_URL=https://app.example.com/dashboard
# COOKIES=session=abc123xyz789
# CRAWL_DEPTH=3
# MAX_PAGES=50

# Example 2: Deep scan with multiple cookies
# TARGET_URL=https://app.example.com
# COOKIES=session_token=abc123,csrf_token=xyz789,user_id=12345
# CRAWL_DEPTH=4
# MAX_PAGES=75
# TIMEOUT=60000

# Example 3: Quick shallow scan
# TARGET_URL=https://example.com
# CRAWL_DEPTH=1
# MAX_PAGES=10
# TIMEOUT=15000

# Example 4: Specific tests only
# TARGET_URL=https://example.com
# INCLUDE_TESTS=XSS Vulnerability Tests,SQL Injection Tests
# CRAWL_DEPTH=2
